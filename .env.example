# Copy this file to .env at the repository root and fill in a real value
# for AEMET_API_KEY. Every other variable is optional; the defaults shown
# here match backend/app/core/config.py.

# Required. Get a free key at:
# https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=aemet-api-key-goes-here

# Optional overrides below.
# AEMET_BASE_URL=https://opendata.aemet.es/opendata
# AEMET_REQUEST_TIMEOUT_SECONDS=10.0
# DATABASE_PATH=backend/data/weather.db
# LOG_LEVEL=INFO
# CORS_ALLOW_ORIGINS=["http://localhost:5173"]
